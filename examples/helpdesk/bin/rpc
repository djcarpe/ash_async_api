#!/usr/bin/env bash
# Evaluate an expression on the running node in this container.
#
#   docker compose exec node1 bin/rpc 'Helpdesk.Demo.open("Printer on fire")'
set -euo pipefail

# Passed through the environment rather than interpolated into the -e string, so the
# expression can contain any quotes or brackets it likes.
export RPC_EXPR="$1"

exec elixir \
  --sname "rpc-$$" \
  --cookie "${ERLANG_COOKIE:-helpdesk-demo}" \
  -e '
    target = :"#{System.fetch_env!("NODE_NAME")}"
    expr = System.fetch_env!("RPC_EXPR")

    unless Node.connect(target) == true do
      IO.puts(:stderr, "could not reach #{target}")
      System.halt(1)
    end

    case :rpc.call(target, Code, :eval_string, [expr]) do
      {:badrpc, reason} ->
        IO.puts(:stderr, "rpc failed: #{inspect(reason)}")
        System.halt(1)

      {result, _bindings} ->
        IO.puts(inspect(result, pretty: true, limit: :infinity, printable_limit: :infinity))
    end
  '
